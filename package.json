{
  "name": "dsh-windows-notifier",
  "version": "0.1.0",
  "description": "DSH plugin: send a native Windows toast notification whenever any DSH conversation needs you — a task finished, a question was asked, or an approval is waiting.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "windows",
    "toast",
    "notification"
  ],
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./messages": "./src/messages.js",
    "./config": "./src/config.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "scripts",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ADkun/dsh-windows-notifier.git"
  },
  "bugs": {
    "url": "https://github.com/ADkun/dsh-windows-notifier/issues"
  },
  "homepage": "https://github.com/ADkun/dsh-windows-notifier#readme",
  "scripts": {
    "test": "node --test test",
    "toast": "node scripts/send-test-toast.mjs"
  }
}